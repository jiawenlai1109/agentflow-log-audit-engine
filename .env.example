# LLM 配置（OpenAI 兼容 Chat Completions 接口，支持任意兼容平台）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 接线只发四个字段：model / messages / temperature / max_tokens（core/llm.py 的 complete）。
# 不发 response_format、不发 tools、不发 stream、不发 thinking——所以任何"能收这四个字段"的
# 兼容端点都接得上，而 Anthropic 原生 /v1/messages 的形状不同（x-api-key 头、system 在顶层、
# 返回 content[0].text），要接它得走一层 OpenAI 兼容网关，不能直接指 base_url。
# 模型名以你的 key 实际能列出来的为准：`GET {base_url}/models` 是唯一权威口径。

# 其他兼容平台示例：
# DeepSeek:  OPENAI_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-flash
#            （旧名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用；
#              思考模式由 thinking 参数控制，而本客户端不发该参数——需要时先扩 complete 的 payload。
#              另注意 total_budget_seconds=120 是墙钟，思考模式的长输出容易撞它。）
# 通义千问:  OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# Ollama 本地: OPENAI_BASE_URL=http://localhost:11434/v1       LLM_MODEL=qwen2.5

# ---- 第三方网关 / 思考档的旋钮（都在 config/agents.yaml 的 llm 段，不放 .env） ----
# thinking: disabled              留空=不发 thinking 字段；上游认不认要实测，别假设
# thinking_budget_retry: true     仅当"reasoning 在场 + finish_reason=length"时提额重试一次
# thinking_budget_factor: 2.0     重试时的预算倍数
# max_tokens_cap: 8000            重试的预算封顶——救不回来就报错，不无限加深
# 另可按角色覆盖：agents.<角色>.thinking / agents.<角色>.model

# ---- Web 鉴权（2026-09-27 起接口强制） ----
# token 签名密钥。**留空则每次启动随机**：重启即踢掉所有已登录会话（安全，但演示时会烦）。
# 生成一条：python -c "import secrets;print('APP_SECRET='+secrets.token_hex(32))"  追加进 .env 即可
APP_SECRET=
# 种子管理员口令，留空则用 admin（启动日志会告警）
ADMIN_PASSWORD=
# API token 有效期（秒），默认 43200 = 12 小时；报告图片用的媒体 token 固定 900 秒
# APP_TOKEN_TTL_SECONDS=43200
