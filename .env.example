# LLM 配置（OpenAI 兼容 Chat Completions 接口，支持任意兼容平台）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 接线只发四个字段：model / messages / temperature / max_tokens（core/llm.py 的 complete）。
# 不发 response_format、不发 tools、不发 stream、不发 thinking——所以任何"能收这四个字段"的
# 兼容端点都接得上，而 Anthropic 原生 /v1/messages 的形状不同（x-api-key 头、system 在顶层、
# 返回 content[0].text），要接它得走一层 OpenAI 兼容网关，不能直接指 base_url。
# 模型名以你的 key 实际能列出来的为准：`GET {base_url}/models` 是唯一权威口径。

# 其他兼容平台示例：
# DeepSeek:  OPENAI_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-flash
#            （旧名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用；
#              思考档位由 llm.thinking 控制，见下面那组旋钮。）
# InkStone（本项目 real 用的这台）: OPENAI_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
#            2026-10-06 用 scripts/preflight_llm.py 实测 10 个型号 × 两档 thinking：
#            8 个开箱可用（kimi-k2.6 / minimax-m3 / qwen3.8-27b / deepseek-v4-flash-0731 /
#            deepseek-v4-flash-vision / deepseek-v4-pro-0813 / Atria-Dawn-Preview / glm-5.3），
#            2 个默认档交白卷、配 thinking: disabled 才正常（Agents-A1、intern-s2），0 个判死。
#            耗时由网关抖动主导而不是 thinking：同一型号两轮之间 vision 默认档 2.3s→26.0s、
#            intern-s2 关思考档 1.1s→19.8s，跨批次比 real 数字之前先排掉这条。
#            判据是"引擎能不能取出可用正文"（core/llm.extract_json），不是"整段是不是 JSON"。
#            逐档读数见 README"实测型号兼容性"。
# 通义千问:  OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# Ollama 本地: OPENAI_BASE_URL=http://localhost:11434/v1       LLM_MODEL=qwen2.5

# ---- 第三方网关 / 思考档的旋钮（都在 config/agents.yaml 的 llm 段，不放 .env） ----
# thinking: disabled              留空=不发 thinking 字段；上游认不认要实测，别假设
# thinking_budget_retry: true     仅当"reasoning 在场 + finish_reason=length"时提额重试一次
# thinking_budget_factor: 2.0     重试时的预算倍数
# max_tokens_cap: 8000            重试的预算封顶——救不回来就报错，不无限加深
# 另可按角色覆盖：agents.<角色>.thinking / agents.<角色>.model
#
# 关于 execution.total_budget_seconds：它**只在波次边界**判定，波次一旦派发出去就跑完当前波，
# 所以它不是"整条 run 的硬顶"（2026-10-06 复核：real 产物里 wall_clock_timeout 零次，
# 而 E21 以 236.656s 跑完并 success，远超这个 120）。慢型号真正会撞的是单请求
# timeout=120s × (1+LLM_MAX_RETRIES) 那一层。

# ---- Web 鉴权（2026-09-27 起接口强制） ----
# token 签名密钥。**留空则每次启动随机**：重启即踢掉所有已登录会话（安全，但演示时会烦）。
# 生成一条：python -c "import secrets;print('APP_SECRET='+secrets.token_hex(32))"  追加进 .env 即可
APP_SECRET=
# 种子管理员口令，留空则用 admin（启动日志会告警）
ADMIN_PASSWORD=
# API token 有效期（秒），默认 43200 = 12 小时；报告图片用的媒体 token 固定 900 秒
# APP_TOKEN_TTL_SECONDS=43200

# ---- 部署形态：数据位置与队列（后端整改 P1/P2，2026-10-07） ----
# 路径的唯一权威就是这一组环境变量：`app/config.py` 在**每次调用时**读它们，
# 不在 import 时算成常量。原因是 P2 之后"跑作业的人"可能是另一个进程
# （`python scripts/worker.py`），它只认环境变量，认不了别人内存里的副本。
# 全部留空 = 用仓库默认路径，行为与改造前逐字节相同。
# APP_DATA_DIR=                   # 元数据库、上传的数据集、Bundle 缓存的根（默认 ./.appdata）
# OUTPUTS_ROOT=                   # 运行产物的根。里面**按企业分树**：
#                                 #   $OUTPUTS_ROOT/org/<企业id>/
#                                 #     run_<日期_时间_8位随机>/   一次运行的产物（报告、图、transcript）
#                                 #     bundles/bd_<指纹>/         引擎的归一化快照缓存
#                                 #     sessions/<会话id>/         多轮上下文
#                                 #   跨企业物理不相交；URL 里没有企业段（仍是 /outputs/<run_id>/<文件>）。
# DB_PATH=                        # 单独指某座库（默认 $APP_DATA_DIR/app.db）
# DATABASE_URL=                   # 换 Postgres 用：postgresql+asyncpg://user:pw@host/db
# DATASETS_DIR=                   # 默认 $APP_DATA_DIR/datasets
# BUNDLES_DIR=                    # 默认 $APP_DATA_DIR/bundles（上传的原始 Bundle，按 bundle_id 分目录）
#
# 原来这里还有一个 `SESSIONS_ROOT`，已删除，而且它**从来没生效过**：引擎算会话目录用的是
# 它拿到的产物根，一个字都不读这个变量。谁设了它，Web 侧就读 A、引擎就写 B，同一份会话被
# 劈成两个目录（表现是"会话历史忽然空了"，且一路不报错）。现在会话位置只有一条推导式：
# `$OUTPUTS_ROOT/org/<会话行的企业归属>/sessions/<会话id>`。
#
# 作业队列：真相在库里，Redis 只是"有活了"的门铃，不配也能跑
# WORKER_CONCURRENCY=2            # **每个进程**几个认领循环。同一个进程里调大不会更快：
#                                 # 实测单进程 8 线程把登录 p95 从 8977.9ms 推到 14378.3ms。
#                                 # 分进程之后这个数才是各进程各自的数，那时加上去才不伤受理层。
#
# 部署形态（P5-3，2026-10-08）。默认不设就是**单进程**：受理层自己也认领作业，一个进程就能跑。
# 要拆成"受理层只受理、执行在独立进程"，是显式的两步：
#     WEB_DISPATCH=off  +  python scripts/worker.py
# 为什么默认是 on：把默认改成 off 等于要求使用者先改环境才能让系统动起来。认不出来的值按 on
# 处理并打一行 warning —— 静默关掉执行的表现是"作业永远排队、每个接口都返回 200"，最难查。
# 两边都吃作业也安全（认领是原子的，一个 job 只会被一个认领者拿到），那时只是多一个消费者。
# 这一格在 `/api/jobs` 的 `dispatch`、进度流第一帧、以及启动日志第一屏都读得到
# （"本进程认领循环 N"是**这个进程**的数，不是平台的数）。
# WEB_DISPATCH=                   # on（默认）/ off；也认 1/0、true/false、yes/no、web/worker
#
# 上游并发闸门（P4，2026-10-08）。上限按三级解析：本变量 > 预检缓存里"这台端点 + 这个型号"
# 的实测干净档 > 保守占位。每一级的出处都跟着读数走（`limit_source`），所以
# "闸门定在 4"永远带着"这个 4 是占位值"或"这个 16 是哪天量出来的"。
# LLM_MAX_CONCURRENCY=            # 手动定档（正整数）。写 0 / 非数字 = 当没配，不会把吞吐掐成 1。
#                                 # 注意它是**每个进程**各自的数：Web 与每个 worker 进程一份。
#                                 # 要重测这台站的上限：`python scripts/preflight_llm.py --concurrency`
#                                 # （它会先打印"将产生 N 次真实调用"再动手；默认档 1/4/8 = 13 次）
# 实测形状（这台网关，2026-10-08）：16 路一波 0 拒绝；32 路一波 6/32 次 HTTP 429。
# 数学上"100 用户同时跑分析"是 100 作业 × 内部 3 路 = 300 路 —— 没闸门时就是拿 300 去撞 16。
# QUOTA_RETRY_AFTER_S=30          # 企业配额超限被拒时回给客户端的退避建议（秒）。
#                                 # 它是**建议不是预测**：没人知道前面那个作业还要跑多久。
#
# 敏感写入口的限流（P4-3，2026-10-08）。计数住在**进程内存**里，所以这些数是"每个进程各自"的额度：
# 受理层拆成 N 个进程，实际速率就是 限额 × N。要做成平台级的得把计数挪进库里（一张尝试表 + 一条
# 迁移），那是单独一片；这里先把半份做扎实，并在读数里自曝 scope=per_process，不含混过去。
# LOGIN_RATE_LIMIT_PER_USER=10    # 同一账号每窗口几次（键取小写去空格：ADMIN 与 admin 同一条预算）
# LOGIN_RATE_LIMIT_PER_SOURCE=60  # 同一来源 IP 每窗口几次（挡"拿一批用户名各试一次"的枚举）
# LOGIN_RATE_WINDOW_S=60          # 上面两道闸的窗口（秒）。固定窗口：边界处最坏放过两倍，方向已知
# ACCOUNT_CREATE_RATE_LIMIT=20    # 单个管理员每小时能开几个号（批量开号是真需求，一秒几十个不是）
# ACCOUNT_CREATE_RATE_WINDOW_S=3600
# RATE_LIMIT_MAX_KEYS=50000       # 记到的 (闸,主体) 条数硬顶；撞顶就逐出最早的键，逐出次数进读数
#                                 # 写 0 / 非数字 = 退回默认值并留一条 warning，不把登录或建号直接掐死
# JOB_LEASE_SECONDS=90            # 租约；worker 被杀后最迟这么久，该 job 被别人重新认领
# JOB_MAX_ATTEMPTS=3              # 最多被认领几次，超了判 failed 并写清原因（不把队列变永动机）
# REDIS_URL=                      # 门铃；没配就退回 1s 轮询，正确性不依赖它
# DB_BUSY_TIMEOUT_S=10            # sqlite3.connect 的等锁秒数
# DB_BUSY_TIMEOUT_MS=10000        # PRAGMA busy_timeout
# DB_POOL_SIZE=20                 # 仅换 Postgres 时生效
# DB_MAX_OVERFLOW=20
