# LLM 配置（OpenAI 兼容 Chat Completions 接口，支持任意兼容平台）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 注意：模型名必须与你的平台支持一致（例如 DeepSeek 官方接口用 deepseek-chat；
# 若使用代理/网关，请以网关返回的 supported model names 为准）。

# 其他兼容平台示例：
# DeepSeek:  OPENAI_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-chat
# 通义千问:  OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# Ollama 本地: OPENAI_BASE_URL=http://localhost:11434/v1       LLM_MODEL=qwen2.5
